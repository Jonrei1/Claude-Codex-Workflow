{
  "description": "Hooks for graph health and automatic Claude verification after Codex turns (Claude + Codex workflow).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const cp=require('node:child_process');const fs=require('node:fs');const path=require('node:path');let root='';try{root=cp.execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8',stdio:['ignore','pipe','ignore']}).trim()}catch{}const f=path.join(root,'.codex','hooks','claude-verify.js');if(root&&fs.existsSync(f))require(f);else console.log('{}')\"",
            "commandWindows": "node -e \"const cp=require('node:child_process');const fs=require('node:fs');const path=require('node:path');let root='';try{root=cp.execFileSync('git.exe',['rev-parse','--show-toplevel'],{encoding:'utf8',stdio:['ignore','pipe','ignore']}).trim()}catch{}const f=path.join(root,'.codex','hooks','claude-verify.js');if(root&&fs.existsSync(f))require(f);else console.log('{}')\"",
            "statusMessage": "Queueing Claude verification"
          }
        ]
      }
    ]
  }
}
